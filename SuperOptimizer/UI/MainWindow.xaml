<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="Super Optimizer V3.9.0 DEV"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#090E1C"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#16233E"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A49"/>
                    <Setter Property="BorderBrush" Value="#F43FB4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#111B31"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A49"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#111B31"/>
            <Setter Property="BorderBrush" Value="#243B63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,6,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#16233E"/>
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#22D3EE"/>
                                <Setter Property="Foreground" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#F43FB4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#111B31"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#243B63"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DarkDataGridCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="DarkDataGridRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#16233E"/>
            <Setter Property="BorderBrush" Value="#243B63"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#1A2A49"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243B63"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#16233E"/>
            <Setter Property="BorderBrush" Value="#243B63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#22D3EE" Offset="0"/>
                    <GradientStop Color="#6EA8FE" Offset="0.48"/>
                    <GradientStop Color="#F43FB4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="30,10,30,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SUPER OPTIMIZER" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="V3.9.0 DEV • Windows 11 Gaming &amp; Manutenção" FontSize="12" Foreground="White" Opacity="0.95"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#33090E1C" CornerRadius="10" Padding="12,7">
                    <TextBlock x:Name="HeaderStatus" Text="ADMIN • PRONTO" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C1426" BorderBrush="#1D2B49" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavHost" Margin="4,12,4,12"/>
                    </ScrollViewer>
                    <Button x:Name="CloseButton" Grid.Row="1" Content="Fechar" Height="42" Margin="14,10,14,18"
                            Foreground="#F1F5F9" Background="#16233E" BorderBrush="#FB7185"
                            BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#090E1C" Padding="28,22,28,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageHost"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
